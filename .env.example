# Run `uv run power-monitor init` to create a private .env with a random admin password.
# Use single quotes around values containing $ or # to keep them literal in Compose.
# Explicit device IPs/hostnames, separated by spaces or commas; DHCP reservations are recommended.
# Example: TAPO_PLUG_DEVICES='192.0.2.10 192.0.2.11'
TAPO_PLUG_DEVICES=

# Tapo account credentials. Legacy Kasa/HS110 devices may work with both empty.
TP_LINK_USERNAME=
TP_LINK_PASSWORD=
PYPROM_EXPORTERS_LOG_LEVEL=INFO

# The admin password initializes a NEW Grafana database; changing it here does not reset a user.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000

# The first retention limit reached removes old blocks; leave disk space beyond this size for WAL/head.
PROMETHEUS_RETENTION_TIME=3y
PROMETHEUS_RETENTION_SIZE=10GB
