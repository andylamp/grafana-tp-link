# Run `uv run power-monitor init` to create a private .env with a random admin password.
# Use single quotes around values containing $ or # to keep them literal in Compose.
# All noncredential settings belong in config/stack.yaml; see optional overrides below.

# Tapo account credentials. Legacy Kasa/HS110 devices may work with both empty.
TP_LINK_USERNAME=
TP_LINK_PASSWORD=

# These initialize a NEW Grafana database; changing them does not reset existing users.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional overrides: uncomment only settings you intend to override from config/stack.yaml.
# Empty values use YAML. Shell values take precedence over values resolved from this file.
# A device override replaces the complete YAML list; separate hosts with spaces or commas.
# TAPO_PLUG_DEVICES=
# PYPROM_EXPORTERS_LOG_LEVEL=
# GRAFANA_BIND_ADDRESS=
# GRAFANA_PORT=
# GRAFANA_DATA_DIRECTORY=
# PROMETHEUS_DATA_DIRECTORY=
# PROMETHEUS_RETENTION_TIME=
# PROMETHEUS_RETENTION_SIZE=
# PROMETHEUS_PORT=
# PROMETHEUS_SCRAPE_INTERVAL=
# PROMETHEUS_SCRAPE_TIMEOUT=
# PROMETHEUS_EVALUATION_INTERVAL=
