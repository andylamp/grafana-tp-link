#!/usr/bin/env bash
# Compatibility entry point; persistent volumes are retained by down/-r.
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-up}" in
    -i) shift; set -- up "$@" ;;
    -r) shift; set -- down "$@" ;;
esac
if [ "$#" -eq 0 ]; then
    set -- up
fi
exec uv run --locked --project "$project_dir" power-monitor --directory "$project_dir" "$@"
