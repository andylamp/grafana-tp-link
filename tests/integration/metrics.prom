current_month_consumption{host="192.0.2.10",alias="Desk (main)"} 12000
current_month_consumption{host="192.0.2.11",alias="Desk (main)"} 23000
# HELP tapo_discovered_devices Number of discovered Tapo devices
# TYPE tapo_discovered_devices gauge
tapo_discovered_devices 2
# HELP process_resident_memory_bytes Resident memory size in bytes
# TYPE process_resident_memory_bytes gauge
process_resident_memory_bytes 10485760
# HELP process_cpu_seconds_total Total user and system CPU time spent in seconds
# TYPE process_cpu_seconds_total counter
process_cpu_seconds_total 12
