# TYPE current_voltage gauge
current_voltage{host="192.0.2.10",alias="Desk (main)"} 230
current_voltage{host="192.0.2.11",alias="Desk (main)"} 240
# HELP current_current Current current in amps
# TYPE current_current gauge
current_current{host="192.0.2.10",alias="Desk (main)"} 0.5
current_current{host="192.0.2.11",alias="Desk (main)"} 1
# HELP current_rssi Current RSSI in dBm
# TYPE current_rssi gauge
current_rssi{host="192.0.2.10",alias="Desk (main)"} -45
current_rssi{host="192.0.2.11",alias="Desk (main)"} -75
# HELP current_consumption_today Energy consumed today in watt-hours
# TYPE current_consumption_today gauge
current_consumption_today{host="192.0.2.10",alias="Desk (main)"} 1200
current_consumption_today{host="192.0.2.11",alias="Desk (main)"} 2300
# HELP current_month_consumption Energy consumed this month in watt-hours
